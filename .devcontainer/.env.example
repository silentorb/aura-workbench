# Host paths relative to .devcontainer/ (sibling repos under ~/dev/).
# Absolute host paths also work and are clearest when scripting docker from inside the engine container.
AURA_ENGINE_PATH=../../aura-engine
AURA_EDITOR_PATH=../../aura-editor
IMP_RS_PATH=../../imp-rs
IMP_SPEC_PATH=../../imp-spec
IMP_LAB_PATH=../../imp-lab
IMP_TS_PATH=../../imp-ts
IMP_GRAPH_EDITOR_PATH=../../imp-graph-editor
IMP_GRAPH_VIEW_PATH=../../imp-graph-view
# Temporary mount; remove with the compose volume when done.
IMP_WORKBENCH_PATH=../../imp-workbench
MIR_PATH=../../mir
# Temporary read-only mount; remove with the compose volume when done.
TOME_PATH=../../tome

# Host path for Windows editor build output (mounted at /out in editor-windows).
# Receives aura-editor.exe + demos/ (Iced) and/or portable aura-editor-tauri.exe (experimental Tauri).
# Relative paths resolve from .devcontainer/ (../.win-out = workbench .win-out/).
# Prefer a Windows-visible absolute path so Explorer sees exports, e.g. /mnt/e/dev/aura.
# Flaky mounts time out and fall back to workbench .win-out (see build-editor-windows.sh /
# build-editor-tauri-windows.sh). Tauri exe needs WebView2 on the Windows host (Edge).
AURA_EDITOR_WIN_OUT=../.win-out
