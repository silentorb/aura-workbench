# Optional overrides (relative to .devcontainer/, or absolute host paths).
# Defaults assume sibling checkouts next to this workbench (../aura-engine, etc.).
AURA_ENGINE_PATH=../../aura-engine
AURA_EDITOR_PATH=../../aura-editor
IMP_RS_PATH=../../imp-rs
IMP_SPEC_PATH=../../imp-spec
IMP_LAB_PATH=../../imp-lab
IMP_TS_PATH=../../imp-ts
IMP_GRAPH_VIEW_PATH=../../imp-graph-view
MIR_PATH=../../mir
# imp_mir (Mir sync fabric) lives in tome-rust-server; aura-engine path-deps it.
TOME_RUST_SERVER_PATH=../../tome-rust-server
SILENTORB_AGENTS_PATH=../../silentorb-agents

# Host path for Windows build output (mounted at /out in editor-windows): portable
# imp-lab.exe plus the Aura pack. Relative paths resolve from .devcontainer/
# (../.win-out = workbench .win-out/). Prefer a Windows-visible path, e.g. /mnt/e/dev/aura.
# Flaky mounts time out and fall back to the workbench .win-out.
AURA_EDITOR_WIN_OUT=../.win-out
