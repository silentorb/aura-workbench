# Host paths relative to .devcontainer/ (sibling repos under ~/dev/).
# Absolute host paths also work and are clearest when scripting docker from inside the engine container.
AURA_ENGINE_PATH=../../aura-engine
AURA_EDITOR_PATH=../../aura-editor
IMP_RS_PATH=../../imp-rs
IMP_SPEC_PATH=../../imp-spec
IMP_LAB_PATH=../../imp-lab
MIR_PATH=../../mir

# Host path for Windows editor build output (mounted at /out in editor-windows).
# Receives aura-editor.exe and demos/ (aura-engine/demos/*.json).
# Relative paths resolve from .devcontainer/ (../.win-out = workbench .win-out/).
# Prefer a Windows-visible absolute path so Explorer sees exports, e.g. /mnt/e/dev/aura.
AURA_EDITOR_WIN_OUT=../.win-out
